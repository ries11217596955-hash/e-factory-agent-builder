{
  "policy_id": "PHASE161H_ACCEPTANCE_PIPELINE_SELF_MAP_REFRESH_POLICY_V1",
  "policy_name": "Acceptance pipeline self-map refresh enforcement",
  "required_after_functional_accept_commit": true,
